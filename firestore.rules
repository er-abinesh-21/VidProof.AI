rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Retention is capped at 90 days (+1 day of client clock skew)
    function validExpiry() {
      return request.resource.data.expires_at is timestamp
          && request.resource.data.expires_at <= request.time + duration.value(91, 'd');
    }

    function isOwner() {
      return request.auth != null && resource.data.user_id == request.auth.uid;
    }

    // Users can only read/write their own documents, and can't hand them to someone else
    match /video_uploads/{id} {
      allow read, delete: if isOwner();
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid
                    && validExpiry();
      allow update: if isOwner()
                    && request.resource.data.user_id == resource.data.user_id
                    && validExpiry();
    }

    match /verification_reports/{id} {
      allow read, delete: if isOwner();
      allow create: if request.auth != null
                    && request.resource.data.user_id == request.auth.uid
                    && validExpiry();
      allow update: if isOwner()
                    && request.resource.data.user_id == resource.data.user_id
                    && validExpiry();
    }
  }
}
