# Firebase Configuration (Firebase console > Project settings > Your apps > Web app)
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Optional: show clearly labelled placeholder results when the AI models can't run
# REACT_APP_DEMO_MODE=false

# File upload limits (optional, defaults shown)
REACT_APP_MAX_FILE_SIZE=104857600  # 100MB in bytes
REACT_APP_ALLOWED_FILE_TYPES=video/mp4,video/quicktime,video/x-msvideo
